# ~/linkedin-mcp/.env (chmod 600). Names real, values replaced.
UNIPILE_API_BASE=https://<UNIPILE_DSN>/api/v1
UNIPILE_API_KEY=<API_KEY>
UNIPILE_ACCOUNT_ID=<UNIPILE_LINKEDIN_ACCOUNT_ID>   # default seat; every tool also takes account_id
LINKEDIN_MCP_PORT=42834
# 1 = drop the daily/weekly invite budget preflight from send_invitation (the duplicate check still runs).
# Set while experimenting with limits; the shared budget (30/day, 170/week) is the normal safeguard.
LINKEDIN_INVITE_UNCAPPED=1
# LINKEDIN_MCP_READONLY=1   # uncomment to REMOVE the six write tools from the tool list entirely
# data/mcp-token.txt holds the connector token (generated once, 0600, survives restarts).
