# deploy/.env as used on the home server (names real, secrets replaced). Loaded by
# career-ops-linkedin-poll.service (optional, "EnvironmentFile=-") and career-ops-telegram.service.
# The older, shorter template is .env.example.

CAREER_OPS_DIR=/home/<YOU>/career-ops

# --- Telegram control bot (phone -> server). Create the bot with @BotFather. ---
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_ALLOWED_CHAT_ID=<TELEGRAM_CHAT_ID>      # the bot serves ONLY this chat; it can send LinkedIn messages as you

# --- Optional cloud keys used by the wider repo ---
MEM0_API_KEY=<API_KEY>
APOLLO_API_KEY=<API_KEY>
GOG_ACCOUNT=<YOUR_EMAIL>                         # Gmail CLI (gog) account for the application-mail sync
GOG_CLIENT=<NAME>

# --- LinkedIn auto-reply (deploy/unipile-poll.mjs) ---
# 1 = send drafted replies; anything else = draft + ping only (the kill switch).
LINKEDIN_AUTOSEND=1
# MESSAGES (replies, first message after an acceptance) are intentionally NOT daily-capped:
# answering someone who wrote to you is not a restricted LinkedIn action and a reply that arrives
# a day late is worse than none. Only INVITATIONS are restricted, so only they are capped:
LINKEDIN_INVITE_DAILY_CAP=10        # this poller's own invite cap/day (code default 10); the LinkedIn MCP's reconciled budget (30/day, 170/week, all senders) sits on top
LINKEDIN_MAX_SENDS_PER_RUN=25       # runaway breaker for ONE poll run, not a ration (busiest real run: 4)
LINKEDIN_POLL_MAX_DRAFTS=5          # model drafts per run (code default 3) so a burst cannot outrun TimeoutStartSec=600

# --- Drafter: local "assist" server (default) or a Claude Managed Agent ---
LINKEDIN_DRAFTER=managed            # unset/other = assist drafter (draft-reply.mjs)
LINKEDIN_MA_AGENT_ID=<AGENT_ID>
LINKEDIN_MA_ENV_ID=<ENVIRONMENT_ID>
LINKEDIN_MA_BUDGET_CENTS=75         # hard spend cap per conversation ($0.75)
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>   # used ONLY by the managed drafter (API billing, unlike the subscription jobs)
