# career-ops Ubuntu host config. Copy to deploy/.env and fill in.
#   cp deploy/.env.example deploy/.env  &&  nano deploy/.env
# Loaded by systemd units (EnvironmentFile) and the helper scripts.

# --- Absolute path to the repo on the Ubuntu box ---
CAREER_OPS_DIR=/home/CHANGE_ME/career-ops

# --- Claude Code auth (pick ONE) ---
# A) Interactive once on the box:  run `claude`  then `/login`  (creds saved in ~/.claude) -> leave key blank.
# B) API key (metered usage):
# ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>

# --- Cloud integrations (already API-based, just move the keys) ---
MEM0_API_KEY=
APOLLO_API_KEY=

# --- Telegram control bot (your phone -> the laptop) ---
# Create a bot via @BotFather, paste its token. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Gmail (gog) for the Agency sync ---
# Note: sync-daily.mjs hardcodes the account; these are documentation/overrides.
GOG_ACCOUNT=you@example.com
GOG_CLIENT=work
# GOG_BIN=gog
