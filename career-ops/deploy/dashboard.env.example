# deploy/dashboard.env (read by deploy/outreach-dashboard.mjs). Names real, values replaced.
DASH_USER=<USERNAME>
DASH_PASS_SCRYPT=<SCRYPT_HASH>      # scrypt hash of the Basic-auth password, not the password itself
DASH_PORT=42837
# A shared secret the SSO/tunnel layer injects so requests that skipped it are refused:
AUTHENTIK_PROOF=<RANDOM_SECRET>
