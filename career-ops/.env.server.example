# Repo-root .env (names only; this file is read by the Python/Node scripts and by Unipile helpers
# via unipileConfig()). Never commit the real one; chmod 600.

UNIPILE_API_BASE=https://<UNIPILE_DSN>/api/v1     # your Unipile DSN
UNIPILE_API_KEY=<API_KEY>
UNIPILE_ACCOUNT_ID=<UNIPILE_LINKEDIN_ACCOUNT_ID>          # default LinkedIn seat
UNIPILE_LINKEDIN_ACCOUNT_ID=<UNIPILE_LINKEDIN_ACCOUNT_ID>
UNIPILE_GMAIL_JOBMAIL_ACCOUNT_ID=<UNIPILE_GMAIL_ACCOUNT_ID>   # connected job-hunt mailbox
UNIPILE_JOBMAIL_ACCOUNT_ID=<UNIPILE_GMAIL_ACCOUNT_ID>
UNIPILE_GMAIL_PERSONAL_ACCOUNT_ID=<UNIPILE_GMAIL_ACCOUNT_ID>
UNIPILE_PERSONAL_GMAIL_ACCOUNT_ID=<UNIPILE_GMAIL_ACCOUNT_ID>

# Recruiter-email discovery / verification (paid, optional)
PROSPEO_API_KEY=<API_KEY>
REOON_API_KEY=<API_KEY>
ZERNIO_API_KEY=<API_KEY>                           # LinkedIn posting/scheduling only, not DMs
TYPESAFE_API_KEY=<API_KEY>
GOG_KEYRING_PASSWORD=<PASSWORD>                    # unlocks the Gmail CLI keyring for unattended sends
