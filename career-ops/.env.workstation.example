# career-ops/.env on the Windows workstation (gitignored). Copy to .env and fill in. Never commit real values.
# (Saved under this name because career-ops/.env.example is the upstream template, owned by the server-side staging.)
# Names and comments mirror the working file; every value is a placeholder.

# --- Unipile (LinkedIn + Gmail API gateway). UNIPILE_API_BASE already ends in /api/v1: do not append it again. ---
UNIPILE_API_BASE=https://<YOUR_UNIPILE_DSN>/api/v1
UNIPILE_API_KEY=<UNIPILE_API_KEY>                 # sent as header X-API-KEY. Never print it in logs or reports.

# --- Server-side enrichment / verification APIs (used by the Hermes recruiter-email scripts on the home server) ---
ZERNIO_API_KEY=<ZERNIO_API_KEY>
REOON_API_KEY=<REOON_API_KEY>                     # email verifier. HTTP 403 "Not enough credits" shows up in the funnel as the masked error `Reoon:verify_error`
PROSPEO_API_KEY=<PROSPEO_API_KEY>                 # email finder. Rate-limits hard: the drafter needs REC_EMAIL_GAP=25 (seconds between lookups)
GOG_KEYRING_PASSWORD=<GOG_KEYRING_PASSWORD>       # unlocks the gog (Google Workspace CLI) keyring on a headless box

# Unipile connected account ids (non-secret).
# Gmail/Google OAuth accounts are used for read/check workflows; LinkedIn is used for outreach.
UNIPILE_ACCOUNT_ID=<UNIPILE_ACCOUNT_ID>
UNIPILE_LINKEDIN_ACCOUNT_ID=<UNIPILE_LINKEDIN_ACCOUNT_ID>
UNIPILE_GMAIL_LEGACY_ACCOUNT_ID=<UNIPILE_ACCOUNT_ID>        # legacy application mailbox
UNIPILE_LEGACY_ACCOUNT_ID=<UNIPILE_ACCOUNT_ID>
UNIPILE_GMAIL_PERSONAL_ACCOUNT_ID=<UNIPILE_ACCOUNT_ID>      # sender mailbox for the primary alias
UNIPILE_PERSONAL_GMAIL_ACCOUNT_ID=<UNIPILE_ACCOUNT_ID>

# --- TypeSafe (first-pass JD screen + fit scoring, typesafe-screen.mjs / typesafe-fit.mjs) ---
TYPESAFE_API_KEY=<TYPESAFE_API_KEY>
